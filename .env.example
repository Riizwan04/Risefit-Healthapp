# Copy to .env.local and fill in. Never commit real keys.
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. One model name or a comma-separated list. If empty, the app tries current Flash models in order.
GEMINI_MODEL=
# 1 = use the built-in demo estimator instead of calling the API
DEMO_MODE=0
